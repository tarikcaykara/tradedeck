{
	"name": "tradedeck",
	"private": true,
	"type": "module",
	"engines": {
		"bun": ">=1.4.3"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"check": "biome check .",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"record:binance": "bun apps/cli/src/record/binance.ts",
		"record:binance-streams": "bun apps/cli/src/record/binance-streams.ts",
		"db:generate": "bun run --cwd packages/db db:generate"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@types/bun": "^1.4.0",
		"typescript": "^7.0.2"
	}
}
